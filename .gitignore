# ======================================================
# 🐍 Python & Django
# ======================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Django static & media files (generated at runtime)
staticfiles/
media/

# SQLite database (used for local development)
db.sqlite3
*.sqlite3
*.sqlite

# Django migration cache
migrations/__pycache__/

# ======================================================
# 💻 Virtual Environment
# ======================================================
venv/
.venv-rbac/
.env
.env.*
.env.bak

# ======================================================
# 🧾 Logs & Temporary Files
# ======================================================
*.log
*.pot
*.pyc
*.pyo
*.pyd
*.tmp
*.temp
*.bak
*.old
*.orig

# ======================================================
# 🧰 Editor & System Files
# ======================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ======================================================
# 🗄️ Databases (MySQL / Access / External)
# ======================================================
*.accdb
*.mdb

# ======================================================
# 📘 Documentation (Sphinx / Auto-generated)
# ======================================================
# Keep /source directory for configuration,
# but ignore auto-generated build outputs
build/
docs/_build/
source/_build/

# ======================================================
# 🧑‍💻 Local Developer Notes & Scripts
# ======================================================
structure.txt
seed/
seed_data.py

# ======================================================
# 📦 Compiled / Distribution Files
# ======================================================
*.egg-info/
dist/
build/
*.manifest
*.spec

# ======================================================
# 🌐 Frontend / Node.js Builds
# ======================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
